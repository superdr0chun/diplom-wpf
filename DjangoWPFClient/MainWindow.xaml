<Window x:Class="DjangoWPFClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система тестирования" Height="520" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Bg}">
    <Grid>
        <!-- Кнопка темы в углу -->
        <Button Content="Тема" Width="36" Height="36" FontSize="14"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0"
                Background="{DynamicResource Surface}"
                Foreground="{DynamicResource Text}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Cursor="Hand" x:Name="ThemeButton"
                Click="ThemeButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <Border Background="{DynamicResource Primary}" Width="64" Height="64"
                    CornerRadius="16" Margin="0,0,0,20">
                <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Система тестирования" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextStrong}"/>

            <TextBlock x:Name="WelcomeText" Text="Войдите в систему"
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,28"/>

            <Button x:Name="LoginButton" Content="Войти" Height="42"
                    Style="{StaticResource BtnPrimary}"
                    Margin="0,0,0,10" Click="LoginButton_Click"/>

            <Button x:Name="RegisterButton" Content="Регистрация" Height="42"
                    Style="{StaticResource BtnSuccess}"
                    Margin="0,0,0,10" Click="RegisterButton_Click"/>

            <Button x:Name="TestsButton" Content="Перейти к тестам" Height="42"
                    Style="{StaticResource BtnAccent}"
                    Margin="0,0,0,10" Visibility="Collapsed"
                    Click="TestsButton_Click"/>

            <Button x:Name="LogoutButton" Content="Выйти" Height="42"
                    Style="{StaticResource BtnDanger}"
                    Visibility="Collapsed" Click="LogoutButton_Click"/>
        </StackPanel>
    </Grid>
</Window>