<Window x:Class="DjangoWPFClient.Views.TestListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступные тесты" Height="640" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{DynamicResource NavBg}" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="Доступные тесты" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button Width="34" Height="34" FontSize="13" Margin="0,0,12,0"
                            Background="Transparent" Foreground="{DynamicResource NavText}"
                            BorderBrush="Transparent" BorderThickness="0" Cursor="Hand"
                            x:Name="ThemeButton" Click="ThemeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
<Border x:Name="NetworkStatus" CornerRadius="4" Padding="8,3"
        Margin="0,0,12,0" VerticalAlignment="Center"
        Background="#10B981">
    <TextBlock x:Name="NetworkStatusText" Text="● Онлайн"
               Foreground="White" FontSize="11" FontWeight="Bold"/>
</Border>
                    <TextBlock x:Name="UserLabel" Foreground="{DynamicResource NavText}"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center"
                               Margin="6,0,10,0" DockPanel.Dock="Left"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="SearchBox" FontSize="13" BorderThickness="0"
                             Padding="0,6" VerticalContentAlignment="Center"
                             Background="Transparent" Foreground="{DynamicResource Text}"
                             TextChanged="SearchBox_TextChanged"/>
                </DockPanel>
            </Border>

            <!-- Контент списка -->
            <Grid Grid.Row="1">
                <TextBlock x:Name="LoadingText" Text="Загрузка тестов..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TextMuted}"/>

                <TextBlock x:Name="EmptyText" Text="Нет доступных тестов"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TextMuted}"
                           Visibility="Collapsed"/>

                <ListView x:Name="TestsListView" Visibility="Collapsed"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="TestsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextStrong}"/>
                                        <TextBlock Text="{Binding Subject}" FontSize="12"
                                                   Foreground="{DynamicResource Accent}"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="{DynamicResource Surface2}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TimeLimitText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSoft}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding QuestionsText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSoft}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding AttemptsText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSoft}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Начать"
                                            Style="{StaticResource BtnSuccess}"
                                            VerticalAlignment="Center" Height="38"
                                            Tag="{Binding Id}" Click="StartTest_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>

        <!-- Футер -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0">
                <Button Content="Обновить" DockPanel.Dock="Left"
                        Style="{StaticResource BtnPrimary}"
                        Click="RefreshButton_Click" Height="36"/>
                <Button Content="Мои результаты" DockPanel.Dock="Left" Margin="10,0,0,0"
                        Style="{StaticResource BtnAccent}"
                        Click="MyResultsButton_Click" Height="36"/>
                <Button Content="Выйти" DockPanel.Dock="Right"
                        Style="{StaticResource BtnDanger}"
                        Click="LogoutButton_Click" Height="36"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>