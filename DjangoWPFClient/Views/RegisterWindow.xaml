<Window x:Class="DjangoWPFClient.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="640" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextStrong}"/>
            <TextBlock Text="Создайте новый аккаунт" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,24"
                       Foreground="{DynamicResource TextMuted}"/>

            <TextBlock Text="Логин" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSoft}" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameTextBox" Style="{StaticResource InputStyle}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Email" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSoft}" Margin="0,0,0,6"/>
            <TextBox x:Name="EmailTextBox" Style="{StaticResource InputStyle}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Пароль" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSoft}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}"
                         Margin="0,0,0,12"/>

            <TextBlock Text="Подтверждение пароля" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSoft}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordStyle}"
                         Margin="0,0,0,20"/>

            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Height="42"
                    Style="{StaticResource BtnSuccess}" Margin="0,0,0,10"
                    Click="RegisterButton_Click" IsDefault="True"/>

            <Button Content="Отмена" Height="38" Style="{StaticResource BtnSecondary}"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>