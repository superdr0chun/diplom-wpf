<Window x:Class="DjangoWPFClient.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="400" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Регистрация нового пользователя"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Поле Username -->
        <Label Grid.Row="1" Grid.Column="0" Content="Имя пользователя:"
              VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UsernameTextBox"
               Width="200" Margin="10,5"/>

        <!-- Поле Email -->
        <Label Grid.Row="2" Grid.Column="0" Content="Email:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="EmailTextBox"
               Width="200" Margin="10,5"/>

        <!-- Поле Password -->
        <Label Grid.Row="3" Grid.Column="0" Content="Пароль:"
               VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBox"
                  Width="200" Margin="10,5"/>

        <!-- Поле Confirm Password -->
        <Label Grid.Row="4" Grid.Column="0" Content="Подтвердите пароль:"
               VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="ConfirmPasswordBox"
                  Width="200" Margin="10,5"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                  HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="RegisterButton" Content="Зарегистрироваться"
                    Width="100" Height="30" Margin="0,0,20,0"
                    Click="RegisterButton_Click"/>
            <Button Content="Отмена" Width="100" Height="30"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
