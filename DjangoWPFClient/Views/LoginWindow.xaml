<Window x:Class="DjangoWPFClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="300" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Username:" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Password:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Войти" Click="LoginButton_Click" Width="80" Margin="0,0,10,0"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
