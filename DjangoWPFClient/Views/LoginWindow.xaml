<Window x:Class="DjangoWPFClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Вход" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextStrong}"/>
            <TextBlock Text="Введите ваши данные" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,24"
                       Foreground="{DynamicResource TextMuted}"/>

            <TextBlock Text="Логин" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSoft}" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameTextBox" Style="{StaticResource InputStyle}"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Пароль" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSoft}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}"
                         Margin="0,0,0,20"/>

            <Button Content="Войти" Height="42" Style="{StaticResource BtnPrimary}"
                    Margin="0,0,0,10" Click="LoginButton_Click" IsDefault="True"/>

            <Button Content="Отмена" Height="38" Style="{StaticResource BtnSecondary}"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>