<Window x:Class="DjangoWPFClient.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прохождение теста" Height="640" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{DynamicResource NavBg}" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TestTitleText" FontSize="14" FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="ProgressText" FontSize="12"
                               Foreground="{DynamicResource NavText}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="14,7"
        VerticalAlignment="Center" x:Name="TimerBorder">
    <TextBlock x:Name="TimerText" Foreground="White"
               FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
</Border>

<Border x:Name="SwitchBorder" DockPanel.Dock="Right" CornerRadius="6" Padding="14,7"
        VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Right"
        Background="{DynamicResource Danger}" Visibility="Collapsed">
    <TextBlock x:Name="SwitchText" Foreground="White"
               FontSize="13" FontWeight="Bold"/>
</Border>
            </DockPanel>
        </Border>

        <!-- Вопрос -->
        <ScrollViewer Grid.Row="1" Margin="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Карточка вопроса -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="QuestionNumberText" FontSize="11"
                                   Foreground="{DynamicResource Accent}"
                                   FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="QuestionText" FontSize="16"
                                   Foreground="{DynamicResource TextStrong}"
                                   TextWrapping="Wrap" LineHeight="24"/>
                        <TextBlock x:Name="QuestionTypeHint" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Варианты -->
                <ItemsControl x:Name="AnswersPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="AnswerBorder"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="2" CornerRadius="8"
                                    Padding="16" Margin="0,0,0,8" Cursor="Hand"
                                    MouseLeftButtonUp="Answer_Click"
                                    Tag="{Binding Id}">
                                <DockPanel>
                                    <Border Width="20" Height="20" CornerRadius="10"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource BorderStrong}"
                                            DockPanel.Dock="Left" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text}" FontSize="14"
                                               Foreground="{DynamicResource Text}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Открытый ответ -->
                <Border x:Name="TextAnswerBorder"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Ваш ответ" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSoft}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="TextAnswerBox" Height="120" FontSize="14"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Навигация -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Content="← Назад" DockPanel.Dock="Left"
                        Style="{StaticResource BtnSecondary}" Height="38"
                        Click="PrevButton_Click"/>
                <Button x:Name="FinishButton" Content="Завершить тест" DockPanel.Dock="Right"
                        Style="{StaticResource BtnDanger}" Height="38"
                        Click="FinishButton_Click"/>
                <Button x:Name="NextButton" Content="Вперёд →" DockPanel.Dock="Right"
                        Style="{StaticResource BtnPrimary}" Height="38"
                        Margin="0,0,10,0" Click="NextButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>