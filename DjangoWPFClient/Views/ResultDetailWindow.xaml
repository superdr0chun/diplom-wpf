<Window x:Class="DjangoWPFClient.Views.ResultDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разбор теста" Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{DynamicResource NavBg}" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TestTitleText" Foreground="White"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScoreSummaryText"
                               Foreground="{DynamicResource NavText}"
                               FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="50" Width="50" Height="50"
                        x:Name="GradeBorder">
                    <TextBlock x:Name="GradeText" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" Margin="24" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AnswersPanel"/>
        </ScrollViewer>

        <!-- Футер -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Button Content="← К результатам" Width="220" Height="36"
                    Style="{StaticResource BtnPrimary}"
                    Click="BackButton_Click"/>
        </Border>
    </Grid>
</Window>