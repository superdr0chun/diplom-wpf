<Window x:Class="DjangoWPFClient.Views.MyResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои результаты" Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{DynamicResource NavBg}" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="Мои результаты" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="UserLabel" Foreground="{DynamicResource NavText}"
                           FontSize="13" VerticalAlignment="Center"
                           HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="24">
            <TextBlock x:Name="LoadingText" Text="Загрузка..."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource TextMuted}"/>

            <TextBlock x:Name="EmptyText" Text="У вас пока нет пройденных тестов."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource TextMuted}"
                       Visibility="Collapsed"/>

            <ListView x:Name="ResultsListView" Visibility="Collapsed"
                      BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="10" Padding="20" Margin="0,0,0,12"
                                Cursor="Hand" Tag="{Binding Id}"
                                MouseLeftButtonUp="ResultBorder_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TestTitle}" FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextStrong}"/>
                                    <TextBlock Text="{Binding DateText}" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ScoreText}" FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Primary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="баллов" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Width="48" Height="48"
                                        CornerRadius="24" Background="{Binding GradeColor}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Grade}" FontSize="20"
                                               FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Футер -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0">
                <Button Content="← К тестам" DockPanel.Dock="Left"
                        Style="{StaticResource BtnPrimary}" Height="36"
                        Click="BackButton_Click"/>
                <Button Content="Обновить" DockPanel.Dock="Right"
                        Style="{StaticResource BtnSuccess}" Height="36"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>